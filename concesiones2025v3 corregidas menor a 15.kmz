<Schema name="ConcesionSchema" id="ConcesionSchema">
	<SimpleField type="string" name="ID">
	<displayName>ID</displayName>
	</SimpleField>
	<SimpleField type="string" name="EMPRESA_ID">
	<displayName>ID Empresa</displayName>
	</SimpleField>
	<SimpleField type="string" name="CONCESION_ID">
	<displayName>ID Concesión</displayName>
	</SimpleField>
	<SimpleField type="string" name="NOMBRE_CONCESION">
	<displayName>Nombre Concesión</displayName>
	</SimpleField>
	<SimpleField type="string" name="NUMERO_DOC_OTORGAMIENTO">
	<displayName>Número Documento</displayName>
	</SimpleField>
	<SimpleField type="string" name="FECHA_DOC_OTORGAMIENTO">
	<displayName>Fecha Otorgamiento</displayName>
	</SimpleField>
	<SimpleField type="string" name="POLIGONAL_ID">
	<displayName>ID Poligonal</displayName>
	</SimpleField>
	<SimpleField type="string" name="ID_CONCESION">
	<displayName>ID Concesión</displayName>
	</SimpleField>
	<SimpleField type="string" name="TIPO_DECRETO">
	<displayName>Tipo Decreto</displayName>
	<!-- Valores posibles: CONCESION|AMPLIACION|TRANSFERENCIA -->
	</SimpleField>
	<SimpleField type="string" name="ESTADO">
	<displayName>Estado</displayName>
	<!-- Valores posibles: EN TRAMITE|OTORGADA|OTORGADA_POR_TRANSFERENCIA|TRANSFERIDA_A_OTRA_EMPRESA -->
	</SimpleField>
	<SimpleField type="string" name="NUMERO_INGRESO_OP_SEC">
	<displayName>Número Ingreso OP a SEC</displayName>
	<!-- Solo para concesiones en tramitación -->
	</SimpleField>
	<SimpleField type="string" name="NUMERO_CASO_TIMES">
	<displayName>Número Caso TIMES</displayName>
	<!-- Solo para concesiones en tramitación -->
	</SimpleField>
	</Schema>
